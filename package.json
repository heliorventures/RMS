{
  "name": "relationship-management-system",
  "version": "1.0.0",
  "description": "Premium Relationship Management System (RMS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "build:assets": "node scripts/build-assets.mjs",
    "check": "npm run build:assets && node --check server.js",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "npm run build:assets && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "seed:admin": "node server/seed/seed-admin.js",
    "seed:sample": "node server/seed/import-sample-data.js",
    "settings:encrypt-secrets": "node server/maintenance/encrypt-settings-secrets.js",
    "data:delete": "node server/maintenance/delete-data.js"
  },
  "keywords": [
    "crm",
    "rms",
    "contacts",
    "campaigns"
  ],
  "author": "RMS Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.4",
    "datatables.net": "^1.13.8",
    "datatables.net-bs5": "^1.13.8",
    "esbuild": "^0.25.0",
    "html2pdf.js": "^0.10.1",
    "jquery": "^3.7.1"
  }
}
