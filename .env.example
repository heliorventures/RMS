PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rms?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Delivery engine
DELIVERY_DRY_RUN=true
DELIVERY_MAX_RETRIES=3
DELIVERY_BATCH_SIZE=25
DELIVERY_POLL_MS=2000
DELIVERY_RETRY_DELAY_MS=5000
DELIVERY_INSERT_CHUNK=1000
SMTP_MAX_CONNECTIONS=5