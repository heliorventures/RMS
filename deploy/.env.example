RMS_IMAGE_TAG=rms-001

NODE_ENV=production
PORT=3000

# Existing VPS Mongo container on the shared Docker network.
MONGODB_URI=mongodb://mongoadmin:password@mongo:27017/rms?authSource=admin
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Required in production. Generate a long random value and keep it secret.
JWT_SECRET=change-this-rms-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Same-origin deployment does not require CORS, but this keeps explicit browser origins supported.
CORS_ORIGIN=https://rms.heliorsoft.com
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Shared Docker network where the existing Caddy and Mongo containers run.
RMS_DOCKER_NETWORK=apps_app-network

# Delivery engine
DELIVERY_DRY_RUN=false
DELIVERY_MAX_RETRIES=3
DELIVERY_BATCH_SIZE=25
DELIVERY_POLL_MS=2000
DELIVERY_RETRY_DELAY_MS=5000
DELIVERY_INSERT_CHUNK=1000
SMTP_MAX_CONNECTIONS=5
